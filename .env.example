# Copy to .env to override any of the local-development defaults below.
#
# Everything here has a working default baked into docker-compose.yml, so
# `docker compose up` succeeds with no .env file present. These are development
# credentials for a stack that binds to localhost. Do not reuse them anywhere
# else.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=sap
POSTGRES_PASSWORD=sap
POSTGRES_DB=sap
POSTGRES_PORT=5432

# --- LiveKit ----------------------------------------------------------------
# Must match deploy/livekit/livekit.yaml. The secret must be >= 32 characters.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevsecret
LIVEKIT_PORT=7880

# --- Observability ----------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Services ---------------------------------------------------------------
INGESTER_PORT=8080
QUERYAPI_PORT=8081

# OTLP endpoint as seen from the application process.
#   inside compose : otel-collector:4317   (the compose default)
#   `make run-local`: localhost:4317       (the Go default in internal/config)
SAP_OTLP_ENDPOINT=otel-collector:4317
SAP_OTLP_INSECURE=true
SAP_ENVIRONMENT=local
